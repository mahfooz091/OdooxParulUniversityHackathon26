# ==========================================
# Traveloop - Environment Variables (.env)
# ==========================================

# 1. Database (Required)
# MongoDB Atlas connection string with username, password, cluster, and database name
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/traveloop?retryWrites=true&w=majority

# 2. Authentication (Required)
# Secure secret key for signing JWT tokens (min 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars
JWT_EXPIRE=30d

# 3. Environment & Networking
NODE_ENV=production
PORT=5001
CLIENT_URL=https://your-app.vercel.app

# 4. Optional Cloudinary (For cloud image uploads)
# If omitted on Vercel, images will gracefully fall back to base64 Data URIs
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. Frontend Client API URL (Optional on Vercel)
# Defaults to '/api' automatically on Vercel
VITE_API_URL=/api
